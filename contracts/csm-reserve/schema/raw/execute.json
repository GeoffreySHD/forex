{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "receive"
      ],
      "properties": {
        "receive": {
          "$ref": "#/definitions/Cw20ReceiveMsg"
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: accept a collateral stablecoin for fee deposits.",
      "type": "object",
      "required": [
        "register_token"
      ],
      "properties": {
        "register_token": {
          "type": "object",
          "required": [
            "collateral_type",
            "token"
          ],
          "properties": {
            "collateral_type": {
              "$ref": "#/definitions/CollateralType"
            },
            "token": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: rebind the core module (deployment wiring).",
      "type": "object",
      "required": [
        "set_core"
      ],
      "properties": {
        "set_core": {
          "type": "object",
          "required": [
            "core"
          ],
          "properties": {
            "core": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: rebind the primary vault (deployment wiring).",
      "type": "object",
      "required": [
        "set_vault"
      ],
      "properties": {
        "set_vault": {
          "type": "object",
          "required": [
            "vault"
          ],
          "properties": {
            "vault": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: execute one buyback of LUNC from the selected reserve.",
      "type": "object",
      "required": [
        "buyback"
      ],
      "properties": {
        "buyback": {
          "type": "object",
          "required": [
            "max_slippage_bps",
            "offer"
          ],
          "properties": {
            "max_slippage_bps": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "offer": {
              "$ref": "#/definitions/CollateralType"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Router callback: report the buyback outcome. Only the configured router may call this.",
      "type": "object",
      "required": [
        "buyback_result"
      ],
      "properties": {
        "buyback_result": {
          "type": "object",
          "required": [
            "purchased",
            "success"
          ],
          "properties": {
            "purchased": {
              "$ref": "#/definitions/Uint128"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "success": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: wire the swap router (DEX) contract.",
      "type": "object",
      "required": [
        "set_router"
      ],
      "properties": {
        "set_router": {
          "type": "object",
          "required": [
            "router"
          ],
          "properties": {
            "router": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: transfer admin authority (governance handover).",
      "type": "object",
      "required": [
        "set_admin"
      ],
      "properties": {
        "set_admin": {
          "type": "object",
          "required": [
            "admin"
          ],
          "properties": {
            "admin": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "CollateralType": {
      "description": "Collateral types accepted for EUTC minting (spec: EURC primary at 1:1, USDC with a 0.5% premium).",
      "type": "string",
      "enum": [
        "eurc",
        "usdc"
      ]
    },
    "Cw20ReceiveMsg": {
      "description": "Cw20ReceiveMsg should be de/serialized under `Receive()` variant in a ExecuteMsg",
      "type": "object",
      "required": [
        "amount",
        "msg",
        "sender"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/Uint128"
        },
        "msg": {
          "$ref": "#/definitions/Binary"
        },
        "sender": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
